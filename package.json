{
  "name": "lets-night",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@lets-night/web",
    "dev:mobile": "turbo dev --filter=@lets-night/mobile",
    "build": "turbo build",
    "build:web": "turbo build --filter=@lets-night/web",
    "lint": "turbo lint",
    "lint:web": "turbo lint --filter=@lets-night/web"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "react-native": "0.81.5",
    "tailwindcss": "^3.4.0",
    "turbo": "^2"
  },
  "overrides": {
    "react-native": "0.81.5",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
