# ─────────────────────────────────────────────────────────────────────────────
# Let's Night — Mobile (Expo). Copia questo file in `apps/mobile/.env.local`
# e compila i valori. NON committare mai .env.local.
# Solo chiavi PUBBLICHE qui: tutto ciò che ha prefisso EXPO_PUBLIC_ finisce nel
# bundle dell'app, quindi NON mettere mai segreti (niente service role, niente sk_).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (lato client)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key — pubblica>

# Stripe — chiave pubblicabile
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_... / pk_live_...>

# URL dell'API web (route /api/stripe/...).
# In DEV viene ricavato AUTOMATICAMENTE dall'host del dev server di Expo
# (vedi lib/apiUrl.js), così segue la rete senza modifiche manuali.
# Questo valore è solo il fallback (build standalone / produzione).
EXPO_PUBLIC_API_URL=http://localhost:3000
