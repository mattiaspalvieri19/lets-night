# ─────────────────────────────────────────────────────────────────────────────
# Let's Night — Web (Next.js). Copia questo file in `apps/web/.env.local`
# e compila i valori. NON committare mai .env.local (contiene segreti).
# Le chiavi vere si chiedono a Mattia.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — progetto
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — pubblica, lato client>

# Supabase — SOLO server (bypassa la RLS). Mai esporla al client né nel mobile.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Email transazionali (Resend)
RESEND_API_KEY=<re_...>

# Stripe
STRIPE_SECRET_KEY=<sk_test_... in dev / sk_live_... in prod>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_... / pk_live_...>

# URL pubblico del sito: usato per i redirect di ritorno da Stripe.
# In dev con l'app mobile metti l'IP LAN del Mac, es: http://192.168.1.50:3000
# (in dev l'app lo sovrascrive comunque passando il proprio host — vedi mobile/lib/apiUrl.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firma webhook Stripe (whsec_...). Vuoto in dev locale; valorizzato in produzione.
STRIPE_WEBHOOK_SECRET=
